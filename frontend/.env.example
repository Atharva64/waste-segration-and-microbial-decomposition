# Copy to .env.local if you need to change these. Both are optional.

# Production builds: public URL of the FastAPI backend (no trailing slash).
# Leave empty in development - the Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=

# Development only: where the proxy forwards /api and /health.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
